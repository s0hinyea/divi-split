{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "assets/new_logo/**",
    "components/Collapsible.tsx",
    "components/ExternalLink.tsx",
    "components/HelloWave.tsx",
    "components/ParallaxScrollView.tsx",
    "components/ui/**"
  ]
}
